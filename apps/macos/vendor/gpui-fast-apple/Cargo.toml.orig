# Modified by Longbridge for gpui-fast publication.
[package]
name = "gpui-fast-apple"
version = "0.1.14"
edition = "2024"
publish = ["crates-io"]
license = "Apache-2.0"
repository = "https://github.com/longbridge/gpui-fast"
homepage = "https://github.com/longbridge/gpui-fast"
readme = "README.md"
documentation = "https://docs.rs/gpui-fast-apple/0.1.14/gpui_apple/"
description = "gpui_apple: GPUI with gpui-fast rendering and layout optimizations"
autoexamples = false
autobenches = false
autotests = false
authors = ["Longbridge"]
include = ["/src/**", "/resources/**", "/build.rs", "/Cargo.toml", "/README.md", "/LICENSE", "/NOTICE"]

[lib]
path = "src/gpui_apple.rs"
doctest = false
name = "gpui_apple"

[features]
default = []
bench-support = ["gpui/bench-support"]
test-support = ["gpui/test-support"]
runtime_shaders = []
font-kit = ["dep:font-kit", "dep:core-text", "dep:objc2-core-text", "dep:pathfinder_geometry"]

[dependencies.gpui]
default-features = false
package = "gpui-fast"
version = "^0.1.14"
path = "../gpui"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.anyhow]
version = "1.0.86"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.async-task]
version = "4.7"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.block2]
version = "0.6"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.collections]
version = "=0.3.12"
package = "gpui-pre-collections"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.core-foundation]
version = "0.10"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.core-foundation-sys]
version = "0.8.6"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.core-graphics]
version = "0.24"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.core-text]
version = "21"
optional = true

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.dispatch2]
version = "0.3"
default-features = false
features = ["std", "block2"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.etagere]
version = "0.2"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.futures]
version = "0.3.34"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.font-kit]
package = "zed-font-kit"
version = "0.14.1-zed"
default-features = false
optional = true
features = ["source"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.gpui_util]
package = "gpui-pre-util"
version = "=0.3.12"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.image]
version = "0.25.1"
default-features = false
features = ["bmp", "dds", "exr", "ff", "gif", "hdr", "ico", "jpeg", "png", "pnm", "qoi", "rayon", "tga", "tiff", "webp"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.libc]
version = "0.2"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.log]
version = "0.4"
default-features = false
features = ["std"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.mach2]
version = "0.6"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2]
version = "0.6"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-core-foundation]
version = "=0.3.2"
default-features = false
features = ["std", "CFData", "CFDictionary", "CFString", "CFNumber", "CFBase", "CFCGTypes"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-core-graphics]
version = "=0.3.2"
default-features = false
features = ["CGDirectDisplay", "CGColorSpace"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-core-text]
version = "0.3.2"
default-features = false
features = ["std", "CTFont", "CTFontDescriptor"]
optional = true

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-core-video]
version = "=0.3.2"
default-features = false
features = ["CVBuffer", "CVImageBuffer", "CVPixelBuffer", "CVMetalTexture", "CVMetalTextureCache", "CVReturn", "objc2", "objc2-metal"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-metal]
version = "0.3.2"
default-features = false
features = ["std", "block2", "dispatch2", "MTLAllocation", "MTLBlitCommandEncoder", "MTLBuffer", "MTLCommandBuffer", "MTLCommandEncoder", "MTLCommandQueue", "MTLDevice", "MTLDrawable", "MTLLibrary", "MTLPixelFormat", "MTLRenderCommandEncoder", "MTLRenderPass", "MTLRenderPipeline", "MTLResource", "MTLTexture", "MTLTypes"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-foundation]
version = "=0.3.2"
default-features = false
features = ["NSArray", "NSAttributedString", "NSBundle", "NSCoder", "NSData", "NSDate", "NSDictionary", "NSEnumerator", "NSError", "NSGeometry", "NSNull", "NSObjCRuntime", "NSObject", "NSProcessInfo", "NSRange", "NSRunLoop", "NSSet", "NSString", "NSURL", "NSValue", "objc2-core-foundation", "std", "NSThread", "NSNotification", "NSOperation", "block2"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-quartz-core]
version = "=0.3.2"
default-features = false
features = ["std", "CALayer", "CAMetalDisplayLink", "CAMetalLayer", "objc2-metal", "objc2-core-foundation", "objc2-core-graphics"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.objc2-security]
version = "0.3.2"
default-features = false
features = ["std", "SecBase", "SecItem"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.parking_lot]
version = "0.12.1"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.pathfinder_geometry]
version = "0.5"
optional = true

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.smallvec]
version = "1.6"
features = ["union", "const_new"]

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".dependencies.thiserror]
version = "2.0.12"

[target."cfg(any(target_os = \"macos\", target_os = \"ios\"))".build-dependencies.cbindgen]
version = "0.28.0"
default-features = false

[lints.rust.unexpected_cfgs]
level = "allow"
