    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice chat uses only your microphone; möbius does not request camera access."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conversations vocales utilisent uniquement votre microphone ; möbius ne demande pas l’accès à la caméra."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprachchats verwenden nur Ihr Mikrofon; möbius fordert keinen Kamerazugriff an."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to unlock möbius."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID pour déverrouiller möbius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Face ID, um möbius zu entsperren."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "möbius connects to gateways you pair with."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "möbius se connecte aux passerelles que vous associez."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "möbius verbindet sich mit Gateways, die Sie koppeln."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the microphone to dictate messages and join voice chats in möbius."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez le microphone pour dicter des messages et participer à des conversations vocales dans möbius."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie das Mikrofon, um Nachrichten zu diktieren und an Sprachchats in möbius teilzunehmen."
          }
        }
      }
    },
