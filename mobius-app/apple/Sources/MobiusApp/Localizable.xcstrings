    "Skip server setup without giving up control. We provision, secure, and maintain a gateway scoped to your account." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Évitez de configurer un serveur sans renoncer au contrôle. Nous mettons en place, sécurisons et entretenons une passerelle limitée à votre compte."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringen Sie die Servereinrichtung, ohne die Kontrolle aufzugeben. Wir stellen ein Gateway für Ihr Konto bereit, sichern und pflegen es."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kiszolgáló beállítását kihagyhatja anélkül, hogy feladná az irányítást. A fiókjához elkülönített átjárót biztosítunk, védünk és tartunk karban."
