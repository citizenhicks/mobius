    "Theme" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thème"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thema"
          }
        }
      }
    },
    "These shell commands run on the gateway when their matching events fire. They stay disabled until you trust them. Trust applies only to the digest above, so an update disables them again." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces commandes shell s’exécutent sur la passerelle lorsque les événements correspondants se produisent. Elles restent désactivées jusqu’à ce que vous leur accordiez votre confiance. Cette confiance ne s’applique qu’au condensat ci-dessus ; toute mise à jour les désactive à nouveau."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Shell-Befehle laufen auf dem Gateway, wenn ihre übereinstimmenden Ereignisse ausgelöst werden. Sie bleiben deaktiviert, bis Sie ihnen vertrauen. Vertrauen gilt nur für den obigen Digest, so dass ein Update sie wieder deaktiviert."
          }
        }
      }
    },
    "This agent inherited %@ from the parent conversation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet agent a reçu %@ de la conversation parente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Agent erbte %@ von der übergeordneten Konversation."
          }
        }
      }
    },
    "This agent inherited the full parent conversation as its starting context." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet agent a hérité de l’intégralité de la conversation parente comme contexte initial."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Agent erbte die vollständige Elternkonversation als Ausgangskontext."
          }
        }
      }
    },
    "This agent started fresh with only its assigned task. It inherited none of the parent conversation." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet agent a démarré sans contexte, avec uniquement la tâche qui lui a été attribuée. Il n’a rien hérité de la conversation parente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Agent begann frisch mit nur der zugewiesenen Aufgabe. Er erbte keine der übergeordneten Konversationen."
          }
        }
      }
    },
    "This app is older than möbius Cloud and can no longer connect. Install the latest build from TestFlight, then reopen the app." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette app est plus ancienne que möbius Cloud et ne peut plus s’y connecter. Installez la dernière version depuis TestFlight, puis rouvrez l’app."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese App ist älter als möbius Cloud und kann keine Verbindung mehr herstellen. Installieren Sie den neuesten Build von TestFlight, und öffnen Sie die App erneut."
          }
        }
      }
    },
    "This App Store subscription is linked to another Cloud account. Sign in to that account or contact support." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet abonnement App Store est associé à un autre compte Cloud. Connectez-vous à ce compte ou contactez l’assistance."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses App Store-Abonnement ist mit einem anderen Cloud-Konto verknüpft. Melden Sie sich bei diesem Konto an oder wenden Sie sich an den Support."
          }
        }
      }
    },
    "This capability is not available in the current chat." : {
      "localizations" : {
        "fr" : {
