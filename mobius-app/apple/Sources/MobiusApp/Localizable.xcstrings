          "stringUnit" : {
            "state" : "translated",
            "value" : "A korábban kiválasztott beszélgetés már nem érhető el."
          }
        }
      }
    },
    "The prompt, model, and capabilities for this chat only." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’invite, le modèle et les fonctionnalités de cette conversation uniquement."
