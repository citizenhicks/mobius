            "value" : "A prompt, a modell és a képességek csak erre a beszélgetésre érvényesek."
          }
        }
      }
    },
    "The prompt, model, and capabilities new chats start from." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
