          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie einen HTTPS Git-Host oder eine URL ein."
          }
        }
      }
    },
    "Enter one or more exact provider model IDs separated by commas. Whitespace, empty entries, and duplicates are ignored. Pick one per chat in the composer." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un ou plusieurs identifiants exacts des modèles du fournisseur, séparés par des virgules. Les espaces, les entrées vides et les doublons sont ignorés. Choisissez-en un par conversation dans la zone de rédaction."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie eine oder mehrere exakte Modell-IDs des Anbieters durch Kommas getrennt ein. Leerzeichen, leere Einträge und Duplikate werden ignoriert. Wählen Sie im Eingabebereich pro Chat eine aus."
          }
        }
      }
    },
    "Enter the exact reasoning efforts supported by these models, separated by commas. Leave empty to use the provider default." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez les niveaux de raisonnement exacts pris en charge par ces modèles, séparés par des virgules. Laissez ce champ vide pour utiliser la valeur par défaut du fournisseur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie die genauen Argumentationsanstrengungen ein, die von diesen Modellen unterstützt werden, getrennt durch Kommas. Lassen Sie das Feld leer, um die Standardeinstellung des Anbieters zu verwenden."
          }
        }
      }
    },
