            "value" : "Einmal an das Gateway gesendet und nie wieder an diese App zurückgegeben. Das Senden eines neuen Schlüssels ersetzt den gespeicherten Schlüssel für dieses Setup."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszer elküldve az átjárónak, és soha nem tért vissza ehhez az alkalmazáshoz. Az új kulcs küldése helyettesíti a beállítás tárolt kulcsát."
          }
        }
      }
    },
    "Sent once to the host's configured Git helper. Möbius does not store or read it back." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
