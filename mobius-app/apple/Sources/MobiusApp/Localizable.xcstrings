        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringen Sie die Servereinrichtung, ohne die Kontrolle aufzugeben. Wir stellen ein Gateway für Ihr Konto bereit, sichern und pflegen es."
