            "state" : "translated",
            "value" : "Geben Sie einen API-Schlüssel ein. Er wird einmal gesendet und nie wieder gelesen."
          }
        }
      }
    },
    "Enter an HTTPS Git host or URL." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez un hôte ou une URL Git HTTPS."
