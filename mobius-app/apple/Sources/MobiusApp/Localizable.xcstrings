    "Trusted for the digest above. An update to a different snapshot disables them until you trust it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiance accordée pour le condensat ci-dessus. Une mise à jour vers un autre instantané les désactive jusqu’à ce que vous leur accordiez de nouveau votre confiance."
